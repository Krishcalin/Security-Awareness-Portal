# Copy to .env for local development. docker-compose.yml provides the
# database; SESSION_SECRET below is a development value and must be replaced
# with a random one anywhere that is not your own machine.
DB_DSN=postgresql://awareness:awareness@127.0.0.1:5434/awareness
SESSION_SECRET=dev-only-not-a-secret-change-me

# Microsoft Entra ID. Empty here on purpose: with these unset, /auth/login
# says so plainly and nobody can sign in, rather than the app falling back
# to something that lets people in. For local work use
# `python -m server.devsession` instead.
#
# ENTRA_TENANT_ID must be the tenant's own id, never `common` or
# `organizations`: those accept a valid token from any Microsoft tenant in
# the world, and every one of those users is a real Microsoft identity.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# Cookies are Secure by default. Switch this off ONLY for local http --
# the other way round is a session cookie that travels in clear the first
# time somebody deploys without reading this file.
COOKIE_SECURE=0
