# Copy to .env for local development. The compose file above provides the
# database; SESSION_SECRET below is a development value and must be replaced
# with a random one anywhere that is not your own machine.
DB_DSN=postgresql://awareness:awareness@127.0.0.1:5434/awareness
SESSION_SECRET=dev-only-not-a-secret-change-me

# Microsoft Entra ID. Empty here because sign-in is wired up in its own step;
# the app refuses to start with a half-configured tenant rather than falling
# back to something that lets people in.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
